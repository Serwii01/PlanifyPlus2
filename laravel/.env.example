APP_NAME=PlanifyPlus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Madrid

# Origen del frontend Angular (CORS)
FRONTEND_URL=http://localhost:4200

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=planifyplus
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Generado con `php artisan jwt:secret`
JWT_SECRET=
JWT_TTL=120
